rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════
    // USUARIOS — Cada cuidador solo ve/escribe SU doc
    // ══════════════════════════════════════
    match /usuarios/{idUsuario} {
      allow read: if request.auth != null && request.auth.uid == idUsuario;

      allow create: if request.auth != null
        && request.auth.uid == idUsuario
        && !request.resource.data.keys().hasAny([
          'correo_respaldo_hash',   // solo servidor (HMAC)
          'nombre',                 // siempre cifrado -> nombre_cifrado
          'telefono',               // siempre cifrado -> telefono_cifrado
          'relacion',               // siempre cifrado -> relacion_cifrada
          'correo_respaldo'         // siempre cifrado -> correo_respaldo_cifrado
        ]);
      allow update: if request.auth != null
        && request.auth.uid == idUsuario
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'correo_respaldo_hash',   // solo servidor (HMAC)
          'nombre',                 // siempre cifrado -> nombre_cifrado
          'telefono',               // siempre cifrado -> telefono_cifrado
          'relacion',               // siempre cifrado -> relacion_cifrada
          'correo_respaldo'         // siempre cifrado -> correo_respaldo_cifrado
        ]);
      allow delete: if request.auth != null && request.auth.uid == idUsuario;

      // Pacientes del cuidador
      match /pacientes/{idPaciente} {
        allow read, delete: if request.auth != null && request.auth.uid == idUsuario;

        // Impide que los datos sensibles se escriban en claro
        allow create: if request.auth != null
          && request.auth.uid == idUsuario
          && !request.resource.data.keys().hasAny([
            'nombreCompleto', 'rut', 'edad', 'diagnostico',
            'tratamientoFase',
            'centroSaludNombre', 'centroSaludDireccion', 'centroSaludTelefono',
            'contactoEmergenciaNombre', 'contactoEmergenciaTelefono'
          ]);
        allow update: if request.auth != null
          && request.auth.uid == idUsuario
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'nombreCompleto', 'rut', 'edad', 'diagnostico',
            'tratamientoFase',
            'centroSaludNombre', 'centroSaludDireccion', 'centroSaludTelefono',
            'contactoEmergenciaNombre', 'contactoEmergenciaTelefono'
          ]);

        // Registros clínicos del paciente cifrados
        match /registrosClinicos/{idRegistro} {
          allow read, delete: if request.auth != null && request.auth.uid == idUsuario;
          allow create: if request.auth != null
            && request.auth.uid == idUsuario
            && request.resource.data.paciente_id == idPaciente  // el documento debe declarar al paciente de su ruta
            && !request.resource.data.keys().hasAny([
              'generalNotes', 'alertMessage',          // nombres de la especificación
              'observaciones', 'mensajeAlerta',        // nombres locales en claro
              'sintomas', 'signosVitales'              // siempre cifrados
            ]);
          allow update: if request.auth != null
            && request.auth.uid == idUsuario
            && request.resource.data.paciente_id == idPaciente  // mismo binding que en create
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'generalNotes', 'alertMessage',
              'observaciones', 'mensajeAlerta',
              'sintomas', 'signosVitales'
            ]);
        }

        // Recordatorios del paciente: título y descripción siempre cifrados
        match /recordatorios/{idRecordatorio} {
          allow read, delete: if request.auth != null && request.auth.uid == idUsuario;
          allow create: if request.auth != null
            && request.auth.uid == idUsuario
            && request.resource.data.pacienteId == idPaciente  // el documento debe declarar al paciente de su ruta
            && !request.resource.data.keys().hasAny([
              'titulo', 'descripcion',  // siempre cifrados -> titulo_cifrado / descripcion_cifrada
              'tipo', 'fechaHora', 'diasRepeticion', 'recurrencia', 'completadoEn'
            ]);
          allow update: if request.auth != null
            && request.auth.uid == idUsuario
            && request.resource.data.pacienteId == idPaciente  // mismo binding que en create
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'titulo', 'descripcion'
            ]);
        }

      }

      // Conversaciones del cuidador: título y mensajes siempre cifrados
      match /conversaciones/{idConversacion} {
        allow read, delete: if request.auth != null && request.auth.uid == idUsuario;
        allow create: if request.auth != null
          && request.auth.uid == idUsuario
          && !request.resource.data.keys().hasAny(['titulo', 'mensajes', 'primeraPregunta']);
        allow update: if request.auth != null
          && request.auth.uid == idUsuario
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['titulo', 'mensajes', 'primeraPregunta']);
      }
    }

    // ══════════════════════════════════════
    // SOLO SERVIDOR — Claves selladas por Cloud KMS y rate limits
    // (el Admin SDK de las funciones ignora las reglas)
    // ══════════════════════════════════════

    // Claves de datos cifradas con Cloud KMS: los clientes nunca leen/escriben.
    match /clavesRecuperacion/{uid} {
      allow read, write: if false;
    }

    // Rate limiting anti-enumeración: solo el servidor escribe/lee.
    match /esperasRecuperacion/{hash} {
      allow read, write: if false;
    }

    // ══════════════════════════════════════
    // BIBLIOTECA EDUCATIVA — lectura para cuidadores autenticados
    // ══════════════════════════════════════
    match /materialEducativo/{idMaterial} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}