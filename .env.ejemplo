# Copiar a .env y cambiar las claves
PUERTO_API=8080
PUERTO_WEB=8015
POSTGRES_USER=oncuidar
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=oncuidar
DATABASE_URL=postgres://oncuidar:cambiar_esta_clave@db:5432/oncuidar
JWT_SECRETO=cambiar_secreto_largo_aleatorio
# 32 bytes en base64
CLAVE_MAESTRA=
HMAC_CORREO=cambiar_secreto_hmac_correo
# Base publica para los enlaces de restablecer contrasena
URL_PUBLICA=http://localhost:8080
# SMTP opcional
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=OnCuidar <no-responder@oncuidar.cl>
