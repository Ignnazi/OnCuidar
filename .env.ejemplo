# Copiar como .env y completar. Nunca subir el .env a git

# Base de datos
POSTGRES_DB=oncuidar
POSTGRES_USER=oncuidar
POSTGRES_PASSWORD=
DATABASE_URL=postgres://oncuidar:<POSTGRES_PASSWORD>@db:5432/oncuidar

# Secretos de la API
# Al menos 16 caracteres
JWT_SECRETO=
# 32 bytes en base64: openssl rand -base64 32
CLAVE_MAESTRA=
HMAC_CORREO=

# Dirección pública de la API, se usa en los enlaces de los correos
URL_PUBLICA=http://localhost:8080

# Correo de la API (sin SMTP_HOST no se envían correos)
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=OnCuidar <no-responder@oncuidar.cl>

# Límite de intentos de inicio de sesión por IP
LIMITE_AUTH=30
VENTANA_AUTH_MS=900000

# Puertos publicados (en parra 8014 y 8015)
PUERTO_API=8080
PUERTO_WEB=8015

# Grafana, el usuario no puede ser admin
GRAFANA_USUARIO=
GRAFANA_CLAVE=
URL_GRAFANA=http://localhost:8015/grafana/

# Alertas por correo (Gmail con clave de aplicación)
ALERTAS_CORREO=
ALERTAS_CLAVE=
