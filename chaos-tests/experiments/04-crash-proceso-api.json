{
  "version": "1.0.0",
  "title": "04 - Caida interna del proceso de Node",
  "description": "Mata el proceso de Node dentro del contenedor con kill -9, como un error fatal o falta de memoria. La API usa init: true, asi que Node no es PID 1 y la senal si lo termina. Docker no lo trata como parada manual y lo vuelve a levantar. Verifica que el contenedor se reinicio y que la API responde.",
  "tags": [
    "docker",
    "api",
    "recuperacion"
  ],
  "steady-state-hypothesis": {
    "title": "La API responde y consulta la base de datos",
    "probes": [
      {
        "type": "probe",
        "name": "salud_antes_de_la_caida",
        "tolerance": 200,
        "provider": {
          "type": "http",
          "url": "http://localhost:8080/api/salud",
          "method": "GET",
          "timeout": 5
        }
      }
    ]
  },
  "method": [
    {
      "type": "action",
      "name": "matar_node_dentro_del_contenedor",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": [
          "compose",
          "exec",
          "api",
          "sh",
          "-c",
          "kill -9 $(pidof node)"
        ],
        "timeout": 60
      }
    },
    {
      "type": "action",
      "name": "esperar_15_segundos",
      "provider": {
        "type": "process",
        "path": "powershell",
        "arguments": [
          "-NoProfile",
          "-Command",
          "Start-Sleep -Seconds 15"
        ],
        "timeout": 60
      }
    },
    {
      "type": "probe",
      "name": "api_se_reinicio",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": [
          "compose",
          "exec",
          "api",
          "sh",
          "-c",
          "test $(( $(date +%s) - $(stat -c %Y /proc/1) )) -lt 60"
        ],
        "timeout": 30
      },
      "tolerance": 0
    },
    {
      "type": "probe",
      "name": "salud_despues_de_la_caida",
      "tolerance": 200,
      "provider": {
        "type": "http",
        "url": "http://localhost:8080/api/salud",
        "method": "GET",
        "timeout": 5
      }
    }
  ],
  "rollbacks": [
    {
      "type": "action",
      "name": "asegurar_sistema_arriba",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": [
          "compose",
          "up",
          "-d",
          "--wait"
        ],
        "timeout": 180
      }
    }
  ]
}
