{
  "name": "oncuidar-backend",
  "version": "1.0.0",
  "description": "API REST de OnCuidar (Express + PostgreSQL)",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "node index.js",
    "test": "jest --runInBand --forceExit",
    "cargar-material": "node scripts/cargar_material.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "..",
    "roots": [
      "<rootDir>/test/integracion"
    ],
    "modulePaths": [
      "<rootDir>/backend/node_modules"
    ],
    "setupFiles": [
      "<rootDir>/test/integracion/entorno.js"
    ],
    "testMatch": [
      "**/*.test.js"
    ]
  }
}
