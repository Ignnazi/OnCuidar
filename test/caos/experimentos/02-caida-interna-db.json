{
  "version": "1.0.0",
  "title": "02 - Caida interna de la base de datos",
  "description": "Apaga PostgreSQL de golpe desde dentro del contenedor con pg_ctl stop -m immediate, como si el proceso fallara solo. Docker no lo trata como parada manual, asi que lo vuelve a levantar. Verifica que la base se reinicia y que la API vuelve a consultarla sin intervencion.",
  "tags": [
    "docker",
    "base-de-datos",
    "recuperacion"
  ],
  "steady-state-hypothesis": {
    "title": "La API consulta la base de datos sin errores",
    "probes": [
      {
        "type": "probe",
        "name": "salud_antes_de_la_caida",
        "tolerance": 200,
        "provider": {
          "type": "http",
          "url": "http://localhost:8080/api/salud",
          "method": "GET",
          "timeout": 5
        }
      }
    ]
  },
  "method": [
    {
      "type": "action",
      "name": "apagar_postgres_de_golpe",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": [
          "compose",
          "exec",
          "-u",
          "postgres",
          "db",
          "pg_ctl",
          "stop",
          "-m",
          "immediate"
        ],
        "timeout": 60
      }
    },
    {
      "type": "action",
      "name": "esperar_15_segundos",
      "provider": {
        "type": "process",
        "path": "powershell",
        "arguments": [
          "-NoProfile",
          "-Command",
          "Start-Sleep -Seconds 15"
        ],
        "timeout": 60
      }
    },
    {
      "type": "probe",
      "name": "db_se_reinicio",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": [
          "compose",
          "exec",
          "db",
          "sh",
          "-c",
          "test $(( $(date +%s) - $(stat -c %Y /proc/1) )) -lt 60"
        ],
        "timeout": 30
      },
      "tolerance": 0
    },
    {
      "type": "probe",
      "name": "salud_despues_de_la_caida",
      "tolerance": 200,
      "provider": {
        "type": "http",
        "url": "http://localhost:8080/api/salud",
        "method": "GET",
        "timeout": 5
      }
    }
  ],
  "rollbacks": [
    {
      "type": "action",
      "name": "asegurar_sistema_arriba",
      "provider": {
        "type": "process",
        "path": "docker",
        "arguments": [
          "compose",
          "up",
          "-d",
          "--wait"
        ],
        "timeout": 180
      }
    }
  ]
}
